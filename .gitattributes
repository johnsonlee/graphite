# Preserve raw oracle output, including whitespace emitted by the JVM server.
docs/go-server-baseline/**/*.log -whitespace
# Unified diffs retain context prefixes before tabs and blank lines.
docs/go-server-baseline/**/*.patch -whitespace
# Go build metadata includes a literal trailing tab on the module line.
docs/go-server-baseline/**/binary-build-info.txt -whitespace
# Raw Maven responses retain HTTP CRLF and directory-listing padding.
docs/go-server-baseline/c4-realboot-timestamp/*.headers -text -whitespace
docs/go-server-baseline/c4-realboot-timestamp/release-index.html -text -whitespace
docs/go-server-baseline/** linguist-generated=true

# Go pprof emits a trailing blank when its raw profile has zero CPU samples.
docs/go-server-baseline/native64-trigram-anchor-attempt7/candidate/profiles/global-wide-four-properties-zero/cpu-cum.txt whitespace=-blank-at-eol
