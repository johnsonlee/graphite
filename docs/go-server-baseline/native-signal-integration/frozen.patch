+:root{font:15px/1.5 system-ui,sans-serif;color:#17283d;background:#f5f7fa}*{box-sizing:border-box}body{margin:0;padding:32px;max-width:1600px;margin-inline:auto}h1{font-size:28px;letter-spacing:-.7px;margin:0}p{margin:6px 0;color:#526178}.stats{display:flex;gap:32px;margin:24px 0}.stats strong{display:block;font-size:22px;color:#17283d}.stats span{font-size:12px;text-transform:uppercase;letter-spacing:.6px}.panel{background:white;border:1px solid #dae1ea;border-radius:10px;padding:16px}.toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:16px}input,button{font:inherit;border:1px solid #becad9;border-radius:5px;padding:7px 10px;background:white;color:inherit}input{width:min(100%,360px)}button{cursor:pointer}button:disabled{opacity:.45;cursor:default}#match{margin-left:auto;color:#526178}#chart{width:100%;overflow:auto;max-height:75vh}svg{display:block;width:100%;min-width:500px}svg text{font:12px system-ui,sans-serif;fill:#241909;pointer-events:none}svg g[role=button]{cursor:pointer}svg g:focus rect{stroke:#173a67;stroke-width:2}#detail{min-height:48px;border-top:1px solid #e5e9ef;margin-top:14px;padding-top:12px;overflow-wrap:anywhere;font-family:ui-monospace,monospace;font-size:12px}#empty{padding:48px 12px;text-align:center}footer{font-size:12px;color:#526178;margin-top:18px}@media(max-width:600px){body{padding:16px}.stats{gap:16px;flex-wrap:wrap}h1{font-size:24px}}
+</style>
+<h1>Graphite CPU profile</h1>
+<p>Click a frame to zoom. Search highlights matching functions. This report works offline.</p>
+<div class="stats"><div><span>Sampled CPU</span><strong id="cpu"></strong></div><div><span>Recording duration</span><strong id="duration"></strong></div><div><span>Sampling period</span><strong id="period"></strong></div></div>
+<div class="panel">
+<div class="toolbar"><label for="search">Find function</label><input id="search" type="search" placeholder="Function or file name"><button id="next" disabled>Next match</button><button id="back" disabled>Back</button><button id="reset">Reset zoom</button><span id="match" aria-live="polite"></span></div>
+<div id="chart"></div><div id="empty" hidden>No CPU samples were recorded. Run work while profiling to capture stacks.</div>
+<p id="limit" hidden></p><p id="labels" hidden>Samples are combined across profiling labels.</p>
+<div id="detail" aria-live="polite">Frame widths show sampled CPU time, not elapsed request latency.</div>
+</div>
+<footer>Native Go runtime CPU samples. Frames narrower than one pixel are hidden; zoom or use Next match to inspect them. Parent frames include their children's CPU time; overlapping inclusive values must not be added.</footer>
+<script id="profile-data" type="application/json">{"root":{"name":"All CPU samples","value":"0"},"durationNanos":"204120708","periodNanos":"10000000","labelsAggregated":false}</script>
+<script>
+ 'use strict';
+const report=JSON.parse(document.getElementById('profile-data').textContent),root=report.root;
+const chart=document.getElementById('chart'),detail=document.getElementById('detail'),search=document.getElementById('search'),back=document.getElementById('back'),next=document.getElementById('next');
+const ns='http://www.w3.org/2000/svg',history=[],all=[],pending=[root];let focus=root,found=[],foundAt=-1;
+
+while(pending.length){const node=pending.pop();node.cpu=BigInt(node.value);all.push(node);for(let i=(node.children||[]).length-1;i>=0;i--)pending.push(node.children[i]);}
+function duration(value){const n=BigInt(value),seconds=n>=1000000000n,unit=seconds?1000000000n:1000000n,places=seconds?3:2,scale=seconds?1000n:100n;return (n/unit).toString()+'.'+((n%unit)*scale/unit).toString().padStart(places,'0')+(seconds?' s':' ms');}
+const percentage=(n,total)=>total===0n?'0.00':(n*10000n/total/100n).toString()+'.'+(n*10000n/total%100n).toString().padStart(2,'0');
+document.getElementById('cpu').textContent=duration(root.cpu);document.getElementById('duration').textContent=duration(report.durationNanos);document.getElementById('period').textContent=report.periodNanos==='0'?'Not specified':duration(report.periodNanos);
+document.getElementById('labels').hidden=!report.labelsAggregated;
+function color(name){let hash=0;for(const c of name)hash=(hash*31+c.charCodeAt(0))|0;return `hsl(${24+Math.abs(hash%25)} 86% ${66+Math.abs(hash%12)}%)`;}
+function render(){
+ chart.replaceChildren();back.disabled=history.length===0;
+ detail.textContent='Viewing '+focus.name+' — '+duration(focus.cpu)+' ('+focus.value+' ns; 100.00% of visible CPU)';
+ document.getElementById('empty').hidden=root.cpu!==0n;
+ const term=search.value.toLowerCase(),matches=n=>term&&(n.name+' '+(n.file||'')).toLowerCase().includes(term);
+ found=term?all.filter(matches):[];next.disabled=found.length===0;
+ if(!focus.cpu){document.getElementById('match').textContent='';return;}
+ let matched=0n,maxDepth=1;const scan=[{node:focus,depth:1,covered:false}];
+ while(scan.length){const {node,depth,covered}=scan.pop(),hit=matches(node);maxDepth=Math.max(maxDepth,depth);if(hit&&!covered)matched+=node.cpu;for(const child of node.children||[])scan.push({node:child,depth:depth+1,covered:covered||hit});}
+ document.getElementById('match').textContent=term?percentage(matched,focus.cpu)+'% of visible CPU matched':'';
+ const width=Math.max(500,chart.clientWidth),levels=Math.min(200,maxDepth),height=levels*26,svg=document.createElementNS(ns,'svg');
+ svg.setAttribute('viewBox',`0 0 ${width} ${height}`);svg.setAttribute('height',height);svg.setAttribute('role','group');svg.setAttribute('aria-label','CPU stack flame graph');
+ const frames=[{node:focus,x:0,w:width,d:0}];let drawn=0,limited=maxDepth>levels;
+ while(frames.length){
+  const {node,x,w,d}=frames.pop();if(w<1||d>=levels)continue;if(drawn===8000){limited=true;break;}drawn++;
+  const g=document.createElementNS(ns,'g'),rect=document.createElementNS(ns,'rect'),title=document.createElementNS(ns,'title'),y=height-(d+1)*26;
+  const location=node.file?node.file+(node.line?':'+node.line:''):'';
+  const description=node.name+' — '+duration(node.cpu)+' ('+node.value+' ns; '+percentage(node.cpu,focus.cpu)+'% of visible CPU)'+(location?' — '+location:'');
+  rect.setAttribute('x',x);rect.setAttribute('y',y);rect.setAttribute('width',Math.max(0,w-.5));rect.setAttribute('height',24);rect.setAttribute('fill',matches(node)?'#b47bdf':color(node.name));
+  title.textContent=description;g.append(rect,title);g.setAttribute('role','button');g.setAttribute('tabindex','0');g.setAttribute('aria-label',description);
+  if(w>20){const text=document.createElementNS(ns,'text');text.setAttribute('x',x+4);text.setAttribute('y',y+17);const chars=Math.max(0,Math.floor((w-8)/7));text.textContent=node.name.length>chars?node.name.slice(0,Math.max(0,chars-1))+'…':node.name;g.append(text);}
+  const zoom=()=>{if(node!==focus){history.push(focus);focus=node;render();}else{detail.textContent=description;}};
+  g.addEventListener('click',zoom);g.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();zoom();}});g.addEventListener('mouseenter',()=>detail.textContent=description);g.addEventListener('focus',()=>detail.textContent=description);svg.append(g);
+  let offset=x;const children=[];for(const child of node.children||[]){const cw=w*Number(child.cpu)/Number(node.cpu);children.push({node:child,x:offset,w:cw,d:d+1});offset+=cw;}for(let i=children.length-1;i>=0;i--)frames.push(children[i]);
+ }
+ const notice=document.getElementById('limit');notice.hidden=!limited;notice.textContent='Display limited to 8,000 frames or 200 levels. Zoom into a parent or use Next match to inspect more. All stacks remain embedded.';
+ chart.append(svg);chart.scrollTop=chart.scrollHeight;
+}
+search.addEventListener('input',()=>{foundAt=-1;render();});next.addEventListener('click',()=>{if(found.length){foundAt=(foundAt+1)%found.length;history.push(focus);focus=found[foundAt];render();}});
+back.addEventListener('click',()=>{if(history.length){focus=history.pop();render();}});document.getElementById('reset').addEventListener('click',()=>{history.length=0;focus=root;render();});window.addEventListener('resize',render);render();
+</script>
