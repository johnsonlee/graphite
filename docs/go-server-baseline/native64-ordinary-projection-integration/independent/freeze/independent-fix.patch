+import io.johnsonlee.graphite.cypher.*;import io.johnsonlee.graphite.graph.*;import io.johnsonlee.graphite.webgraph.*;import com.google.gson.*;import java.util.*;import java.nio.file.*;
+public class CacheUnicodeOracle {
+ static long bytes(Graph g)throws Exception {var f=g.getClass().getDeclaredField("callSiteStringIndex");f.setAccessible(true);Object i=f.get(g);return (long)i.getClass().getMethod("getRetainedBytes").invoke(i);}
+ public static void main(String[] a)throws Exception{Graph g=GraphStore.INSTANCE.loadMapped(Path.of(a[0]));var e=new CypherExecutor(g);e.execute("MATCH (n) WHERE n.caller_name CONTAINS 'other' RETURN DISTINCT n.caller_name AS x LIMIT 2");var rows=new ArrayList<Object>();String q="MATCH (n) WHERE toLower(n.caller_name) CONTAINS $term RETURN n.caller_name AS x LIMIT 2";String[] terms={"😀x",new String(new char[]{0xd83d,0xde00,'x'}),new String(new char[]{0xd83d,'x','y'}),new String(new char[]{0xde00,'x','y'}),"😀x","😀x","😀x","😀x"};for(int at=0;at<terms.length;at++){String term=terms[at];String query=q;if(at==5)query=q.replace("AS x", "AS `😀`");if(at==6)query=q.replace("n.caller_name AS x", "n.caller_name AS a,n.caller_name AS b");if(at==7)query=q.replace("n.caller_name AS x", "n.caller_name AS b,n.caller_name AS a");var r=e.execute(query,Map.of("term",term));var row=new LinkedHashMap<String,Object>();row.put("utf16",term.chars().boxed().toList());row.put("columns",r.getColumns());row.put("rows",r.getRows());row.put("retainedBytes",bytes(g));rows.add(row);}((java.io.Closeable)g).close();Files.writeString(Path.of(a[1]),new GsonBuilder().serializeNulls().setPrettyPrinting().create().toJson(rows)+"\n");}
+}
