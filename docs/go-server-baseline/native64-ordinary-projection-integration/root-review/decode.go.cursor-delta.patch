+// newMappedNodeDecoder borrows only the current Node call's mapped suffix.
+// Complete node decoding consumes scalar bytes immediately; returned Node values
+// never retain this slice. Reader-backed bytes keeps its owning-copy contract.
+func newMappedNodeDecoder(data []byte, table []string) *decoder {
+	return &decoder{mappedNode: data, isMappedNode: true, remaining: int64(len(data)), strings: table}
+}
+func (d *decoder) scalarBytes(n int) []byte {
+	if !d.isMappedNode {
+		return d.bytes(n)
+	}
+	if d.err != nil {
+		return nil
+	}
+	if n < 0 || int64(n) > d.remaining {
+		d.fail("truncated data: need %d bytes, have %d", n, d.remaining)
+		return nil
+	}
+	b := d.mappedNode[:n]
+	d.mappedNode = d.mappedNode[n:]
