<?xml version='1.0' encoding='utf-8'?>
<configuration version="2.0" label="Graphite query ownership control" description="Diagnostic only; benchmark query events and native JVM events, no production method tracing" provider="local diagnostic">
  <event name="graphite.diagnostic.QueryExecution">
    <setting name="enabled">true</setting>
    <setting name="threshold">0 ns</setting>
    <setting name="stackTrace">false</setting>
  </event>
  <event name="jdk.JVMInformation">
    <setting name="enabled">true</setting>
    <setting name="period">beginChunk</setting>
  </event>
  <event name="jdk.ActiveRecording">
    <setting name="enabled">true</setting>
  </event>
  <event name="jdk.ActiveSetting">
    <setting name="enabled">true</setting>
  </event>
  <event name="jdk.DataLoss">
    <setting name="enabled">true</setting>
  </event>
</configuration>