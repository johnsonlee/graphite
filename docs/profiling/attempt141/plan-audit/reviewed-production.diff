+/** Uses direct property membership only when its payload fits within the replaced hash arrays. */
+@Suppress("LoopWithTooManyJumpStatements")
+internal fun rawExactStringPropertyFlags(
+    stringCount: Int,
+    propertyIndexes: List<Int>,
+    exactMatchingStringIds: List<IntArray>
+): ByteArray? {
+    if (Thread.currentThread().isInterrupted) {
+        throw CancellationException(MAPPED_STRING_PROPERTY_SCAN_INTERRUPTED)
+    }
+    if (stringCount <= 0 || propertyIndexes.size != exactMatchingStringIds.size ||
+        propertyIndexes.any { it !in 0 until CALL_SITE_STRING_PROPERTY_COUNT }
+    ) return null
+    var hashPayloadBytes = 0L
+    for (ids in exactMatchingStringIds) {
+        val keyBytes = (HashCommon.arraySize(ids.size, Hash.DEFAULT_LOAD_FACTOR) + 1L) * Int.SIZE_BYTES
+        // Saturation at the comparison target keeps the sum safe for any predicate count.
+        hashPayloadBytes = minOf(stringCount.toLong(), hashPayloadBytes + keyBytes)
+    }
+    if (hashPayloadBytes < stringCount) return null
+
+    // A malformed candidate must retain the original hash behavior, without first allocating a table.
+    for (ids in exactMatchingStringIds) {
+        for (index in ids.indices) {
+            checkRawExactFlagsInterrupted(index)
+            if (ids[index] !in 0 until stringCount) return null
+        }
+    }
+    val flags = ByteArray(stringCount)
+    for (predicateIndex in exactMatchingStringIds.indices) {
+        val propertyFlag = 1 shl propertyIndexes[predicateIndex]
+        val ids = exactMatchingStringIds[predicateIndex]
+        for (index in ids.indices) {
+            checkRawExactFlagsInterrupted(index)
+            val stringId = ids[index]
+            flags[stringId] = (flags[stringId].toInt() or propertyFlag).toByte()
+        }
+    }
+    return flags
+}
+
+private fun checkRawExactFlagsInterrupted(index: Int) {
+    if ((index and RAW_SCAN_INTERRUPTION_POLL_MASK) == 0 && Thread.currentThread().isInterrupted) {
+        throw CancellationException(MAPPED_STRING_PROPERTY_SCAN_INTERRUPTED)
+    }
+}
